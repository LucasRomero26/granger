# Granger Backend - Environment variables
#
# Copy this file to .env and fill in the real values.
# NEVER commit the real .env file.

# App
NODE_ENV=development
PORT=4000

# Database (MongoDB Atlas)
DATABASE_URL=mongodb+srv://granger_user:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/granger?retryWrites=true&w=majority

# JWT (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=YOUR_ACCESS_SECRET_AT_LEAST_32_CHARS_LONG
JWT_REFRESH_SECRET=YOUR_REFRESH_SECRET_AT_LEAST_32_CHARS_LONG
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# Brevo (emails, free 300/day, no per-recipient sandbox)
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxx
BREVO_FROM_EMAIL=granger@example.com

# Cloudinary (avatars)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_PRESET=granger_avatars

# Google OAuth
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx

# GitHub OAuth
GITHUB_OAUTH_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
GITHUB_OAUTH_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sentry (error monitoring)
SENTRY_DSN_BACKEND=https://your-key@sentry.io/your-project-id
SENTRY_DSN=https://your-key@sentry.io/your-project-id

# Better Stack (logging)
LOGTAIL_SOURCE_TOKEN=xxxxxxxxxxxxxxxx
LOGTAIL_INGESTING_HOST=sxxxxxxxxxx.eu-central-1a.betterstackdata.com

# Redis (optional, for distributed rate limiting in production)
REDIS_URL=redis://localhost:6379

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=5
AUTH_BLOCK_DURATION_MS=900000
