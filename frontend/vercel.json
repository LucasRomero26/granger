{
  "trailingSlash": false,
  "rewrites": [
    { "source": "/projects/:projectId", "destination": "/app-shell.html" },
    { "source": "/projects/:projectId/edit", "destination": "/app-shell.html" },
    { "source": "/projects/:projectId/team", "destination": "/app-shell.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/projects/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
